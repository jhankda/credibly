# Solana
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
NEXT_PUBLIC_PROGRAM_ID=HYLVH9iBUSroAyDViFn6fY7WirfPuv1kG89TCyvAz5fx

# IPFS (Pinata)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET=your_pinata_secret
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Production App URL (update to your production domain on Vercel)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=your_production_secret_key

# Optional / External Integrations
ARWEAVE_WALLET_KEY=your_solana_private_key_for_bundlr
ARWEAVE_GATEWAY=https://arweave.net
DIGILOCKER_CLIENT_ID=your_client_id
DIGILOCKER_CLIENT_SECRET=your_client_secret
DIGILOCKER_REDIRECT_URI=https://your-app.vercel.app/api/digilocker/callback
# Locally, the AI proxy defaults to http://localhost:8000. Vercel injects
# AI_SERVICE_URL through the app-to-ai service binding in vercel.json.
